# ─── Obligatorio ───────────────────────────────────────────────
# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ─── Base de datos ─────────────────────────────────────────────
# Sin DATABASE_URL se usa PostgreSQL embebido (PGlite) en ./data/pg.
# En producción, un servidor PostgreSQL:
# DATABASE_URL=postgres://usuario:contraseña@host:5432/flota
# PGLITE_DIR=./data/pg
# AUTO_MIGRATE=true

# ─── Documentos ────────────────────────────────────────────────
# Carpeta privada para los documentos originales (fuera de /public).
# STORAGE_DIR=./data/documents

# ─── Reconocimiento de documentos (motor local, sin APIs de pago) ──
# local = PaddleOCR + reglas en Python (carpeta ocr-engine, se inicia con «npm run ocr») | none
EXTRACTION_PROVIDER=local
# Dirección del motor local. Por seguridad sólo se admite este equipo (127.0.0.1)
# salvo OCR_ENGINE_ALLOW_REMOTE=1 (otro equipo de tu propia red).
# OCR_ENGINE_URL=http://127.0.0.1:8765

# Opciones del motor (las lee ocr-engine al arrancar):
# OCR_MODE=auto            auto | ocr | structure  (PP-StructureV3 para tablas)
# OCR_DET_MODEL=PP-OCRv5_mobile_det   modelos más ligeros si el equipo es lento
# OCR_REC_MODEL=PP-OCRv5_mobile_rec
# Intérprete visual opcional, 100 % local con Ollama (no instalado por defecto):
# QWEN_ENABLED=1
# QWEN_MODEL=qwen2.5vl:3b
# OLLAMA_URL=http://127.0.0.1:11434
